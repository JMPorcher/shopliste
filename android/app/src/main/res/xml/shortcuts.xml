<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.ADD_ITEM_TO_LIST">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.einkaufsliste"
            android:targetClass="com.example.einkaufsliste.MainActivity">
            <data android:scheme="einkaufsliste" android:host="add" />
            <parameter
                android:name="item.name"
                android:key="item"/>
        </intent>
    </capability>
</shortcuts>